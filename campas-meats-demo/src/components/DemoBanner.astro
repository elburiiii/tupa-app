---
/**
 * Required disclosure: always visible, fixed to the bottom of the viewport.
 * The "demo tools" let the presenter fast-forward the date or flip the shop status
 * during a pitch without editing files. They only change this browser tab.
 */
import { UI, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = UI[lang];
const statusLabel = lang === 'fi' ? 'Myymälän tila' : 'Shop status';
const fromFile = lang === 'fi' ? 'Tiedoston mukaan' : 'From file';
---
<aside aria-label={lang === 'fi' ? 'Demotiedote' : 'Demo notice'} class="on-dark fixed inset-x-0 bottom-0 z-40 border-t-2 border-brass-light bg-oxblood-900 text-cream shadow-[0_-4px_16px_rgb(0_0_0/0.2)]">
  <div class="container-x flex flex-wrap items-center justify-between gap-x-4 gap-y-1 py-2 text-[0.8125rem] leading-snug">
    <p><strong class="font-semibold">{t.demoBanner}</strong></p>
    <details class="group relative">
      <summary class="cursor-pointer list-none py-1 font-semibold text-brass-light underline">{lang === 'fi' ? 'Demotyökalut' : 'Demo tools'}</summary>
      <div class="fixed inset-x-3 bottom-20 border-2 sm:absolute sm:inset-x-auto sm:bottom-full sm:right-0 sm:mb-3 sm:w-72 border-brass-light bg-charcoal p-4 text-cream shadow-xl">
        <p class="mb-3 text-cream/85">{t.demoToolsHelp}</p>
        <label for="demo-date" class="mb-1 block font-semibold">{t.demoTools}</label>
        <div class="flex gap-2">
          <input id="demo-date" type="date" data-demo-date class="min-h-11 w-full border border-cream/40 bg-charcoal-800 px-2 text-cream [color-scheme:dark]" />
          <button type="button" data-demo-reset class="btn btn-ghost !min-h-11 !px-3 text-sm">{t.demoReset}</button>
        </div>
        <label for="demo-status" class="mb-1 mt-4 block font-semibold">{statusLabel}</label>
        <select id="demo-status" data-demo-status class="min-h-11 w-full border border-cream/40 bg-charcoal-800 px-2 text-cream">
          <option value="">{fromFile}</option>
          <option value="open">{t.status.open}</option>
          <option value="sold-out">{t.status['sold-out']}</option>
          <option value="closed">{t.status.closed}</option>
        </select>
      </div>
    </details>
  </div>
</aside>
