---
import { UI, fmtTimeRange, fmtDate, tr, type Lang } from '../lib/i18n';
import { hours, upcomingExceptions } from '../lib/content';
interface Props { lang: Lang; compact?: boolean }
const { lang, compact = false } = Astro.props;
const t = UI[lang];
---
<div>
  <table class="w-full border-collapse text-left">
    <caption class="sr-only">{t.hours}</caption>
    <tbody>
      {hours.regular.map((d) => (
        <tr class="border-b border-current/15">
          <th scope="row" class:list={['py-2 pr-4 font-normal', compact && 'py-1']}>{t.days[d.day]}</th>
          <td class:list={['py-2 text-right tabular-nums', compact && 'py-1', !d.open && 'opacity-80']}>{d.open ? fmtTimeRange(d.open, d.close, lang) : t.closedDay}</td>
        </tr>
      ))}
    </tbody>
  </table>
  {hours.is_example && <p class="mt-2"><span class="tag-example">{t.exampleHours}</span></p>}
  {!compact && upcomingExceptions.length > 0 && (
    <div class="mt-8" data-fresh-list>
      <h3 class="mb-3 text-xl text-oxblood">{t.exceptions}</h3>
      <table class="w-full border-collapse text-left">
        <caption class="sr-only">{t.exceptions}</caption>
        <tbody>
          {upcomingExceptions.map((x) => (
            <tr data-expires={x.date} class="border-b border-current/15">
              <th scope="row" class="py-2 pr-4 font-normal">
                <span class="block">{tr(x, 'label', lang)}</span>
                <span class="text-sm text-ink-muted">{fmtDate(x.date, lang)}</span>
              </th>
              <td class="py-2 text-right tabular-nums">{x.open ? fmtTimeRange(x.open, x.close, lang) : t.closedDay}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</div>
